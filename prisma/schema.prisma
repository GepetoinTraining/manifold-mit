// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Remove the url line entirely
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      String   @default("STUDENT")
  createdAt DateTime @default(now())
  
  devices   Device[]
  sessions  Session[]
}

model Device {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprint String   @unique
  userAgent   String
  status      String
  createdAt   DateTime @default(now())
  
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([expiresAt])
}